{
  "manifest_version": 3,
  "name": "Open Download Manager Integration",
  "version": "0.2.0",
  "description": "Hands downloads to the Open Download Manager daemon: parallel connections, resume, HLS/DASH capture.",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "notifications",
    "cookies",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Download Manager"
  },
  "options_ui": {
    "page": "popup.html#options",
    "open_in_tab": true
  }
}
